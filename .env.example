# ==============================================================================
# REG24 — Neo4j AuraDB Graph Database Configuration (REG24-INFRA-NEO4J-001)
# Server-side only. Never commit real credentials or expose with NEXT_PUBLIC_.
# ==============================================================================
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Graph operating mode:
# - "neo4j_with_explicit_degraded_read" (default when AuraDB is being provisioned)
# - "neo4j_strict" (enforces HTTP 503 if Neo4j AuraDB is unreachable — REG-NEO-017)
REG24_GRAPH_MODE=neo4j_with_explicit_degraded_read

# ==============================================================================
# REG24 — Google Gemini Primary LLM Provider Configuration (REG24-INFRA-LLM-001)
# Get your API Key at Google AI Studio: https://aistudio.google.com/app/apikey
# Server-side only. Add GEMINI_API_KEY in .env.local or Vercel Project Settings.
# ==============================================================================
GEMINI_API_KEY=AIzaSy...
GEMINI_ECONOMY_MODEL=gemini-2.5-flash-lite
GEMINI_BALANCED_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro

# Optional fallback providers (OpenAI / Anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

