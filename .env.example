# ==============================================================================
# REG24 — Neo4j AuraDB Graph Database Configuration (REG24-INFRA-NEO4J-001)
# Server-side only. Never commit real credentials or expose with NEXT_PUBLIC_.
# ==============================================================================
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Graph operating mode:
# - "neo4j_with_explicit_degraded_read" (default when AuraDB is being provisioned)
# - "neo4j_strict" (enforces HTTP 503 if Neo4j AuraDB is unreachable — REG-NEO-017)
REG24_GRAPH_MODE=neo4j_with_explicit_degraded_read
